{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buoy Mobile",
  "version": "0.1.0",
  "identifier": "com.buoy.app.mobile",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Buoy"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self' data:; frame-src 'self' buoyhtml:",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../../assets/icons/32x32.png",
      "../../../assets/icons/128x128.png",
      "../../../assets/icons/128x128@2x.png",
      "../../../assets/icons/icon.icns",
      "../../../assets/icons/icon.ico"
    ]
  }
}
